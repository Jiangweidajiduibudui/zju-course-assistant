{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/shared/contracts/**/*.ts",
    "src/domain/contracts.ts",
    "tests/contracts/**/*.ts",
    "scripts/generate-openapi.ts"
  ]
}
